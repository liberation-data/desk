{
  "name": "@liberation-data/desk",
  "version": "0.0.1",
  "description": "A desktop for the web: windows that tile first and float when asked, for React.",
  "license": "Apache-2.0",
  "author": "Jasper Blues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liberation-data/desk.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "llms.txt",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./desk.css": "./dist/desk.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/desk.css dist/desk.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "vite examples/garage",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "size": "node scripts/size.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run size"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
