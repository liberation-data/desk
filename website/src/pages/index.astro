        <script>
            // Copy buttons: copy the text of the element named by data-copy, and say so for a moment. Where there is no
            // clipboard, select the text instead, ready to copy by hand.
            for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
                button.addEventListener('click', async () => {
                    const source = document.getElementById(button.dataset.copy!);
                    try { await navigator.clipboard.writeText(source?.textContent ?? ''); button.textContent = 'Copied'; }
                    catch { if (source) getSelection()?.selectAllChildren(source); button.textContent = 'Selected'; }
                    setTimeout(() => (button.textContent = 'Copy'), 1600);
                });
            }
        </script>
        <script>
            // The bird: a raptor soaring in wide, slow circles high in the sky, seen from below. It glides on a tilted
            // ellipse (one lap in about 48 s), turns to face where it is going, grows a little as the near side of the
            // circle brings it closer, and now and then gives three slow wingbeats. It holds still, mid-glide, for
            // reduced motion, and stops while the sky is out of sight or the tab hidden. Phones, whose sky is mostly headline,
            // don't show it, so nothing moves it there.
            const hero = document.querySelector<HTMLElement>('.hero');
            const bird = hero?.querySelector<HTMLElement>('.bird');
            const wings = bird ? [...bird.querySelectorAll<SVGPathElement>('.wing')] : [];
            if (hero && bird) {
                const still = matchMedia('(prefers-reduced-motion: reduce)');
                const phone = matchMedia('(max-width: 640px)'); // as the stylesheet hides it
                const LAP = 48_000, FLAP_EVERY = 13_000, BEAT = 620, BEATS = 3;
                let inView = true, frame = 0, elapsed = 0.31 * LAP, last = 0;

                const place = (t: number) => {
                    const w = hero.clientWidth, h = hero.clientHeight;
                    const cx = w * 0.7, cy = h * 0.27, rx = w * 0.16, ry = rx * 0.38;
                    const a = (t / LAP) * Math.PI * 2;
                    const x = cx + rx * Math.cos(a), y = cy + ry * Math.sin(a);
                    const heading = Math.atan2(ry * Math.cos(a), -rx * Math.sin(a));
                    const near = 1 + 0.14 * Math.sin(a);
                    bird.style.transform = `translate(${x - 38}px, ${y - 15}px) rotate(${heading + Math.PI / 2}rad) scale(${near})`;
                    const since = t % FLAP_EVERY, beat = since < BEAT * BEATS ? Math.sin((since / BEAT) * Math.PI) ** 2 : 0;
                    for (const wing of wings) wing.style.transform = `scaleX(${1 - 0.42 * beat})`;
                };
                const tick = (now: number) => {
                    if (last) elapsed += Math.min(now - last, 100);
                    last = now;
                    place(elapsed);
                    frame = requestAnimationFrame(tick);
                };
                const sync = () => {
                    cancelAnimationFrame(frame);
                    last = 0;
                    if (phone.matches) return;
                    if (still.matches || !inView || document.hidden) { place(elapsed); return; }
                    frame = requestAnimationFrame(tick);
                };
                new IntersectionObserver((entries) => { inView = entries.some((e) => e.isIntersecting); sync(); }).observe(hero);
                document.addEventListener('visibilitychange', sync);
                still.addEventListener('change', sync);
                phone.addEventListener('change', sync);
                addEventListener('resize', () => { if (!phone.matches) place(elapsed); });
                sync();
            }
        </script>
    </body>
